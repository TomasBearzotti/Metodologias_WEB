PORT=3000
NODE_ENV=development
# URI de conexion a MongoDB (Local: mongodb://localhost:27017/movie-catalog | Produccion: MongoDB Atlas)
MONGODB_URI=
# Secreto para Better Auth (generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET=
# URL publica del Frontend (Local: http://localhost:5173 | Produccion: https://<tu-static-site>.onrender.com)
BETTER_AUTH_URL=http://localhost:5173
# Credenciales OAuth App de GitHub (Local: callback http://localhost:3000/api/auth/callback/github | Prod: Render backend URL)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Credenciales OAuth de Google (Local: callback http://localhost:3000/api/auth/callback/google | Prod: Render backend URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
